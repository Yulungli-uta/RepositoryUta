<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <!-- Quitar handlers de IIS que interceptan OPTIONS/WebDAV antes de llegar a ASP.NET Core -->
        <remove name="WebDAV"/>
        <remove name="OPTIONSVerbHandler"/>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified"/>
      </handlers>
      <modules>
        <remove name="WebDAVModule"/>
      </modules>
      <aspNetCore processPath="dotnet"
                  arguments=".\WsSeguUta.AuthSystem.API.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess"/>
      <webSocket enabled="true"/>
      <security>
        <requestFiltering>
          <!-- Default de IIS es 2048 bytes: un code+state real de Azure AD (PKCE, con
               stateId+clientId+browserId codificados en base64) lo supera y IIS rechaza
               la petición antes de que llegue a la app (404 "File or directory not found",
               sin rastro en los logs de la app). Ver /api/auth/azure/callback. Confirmado
               2026-10-01 con una URL real capturada en vivo: query string de 2142 bytes,
               por encima del límite de 2048. Se deja un margen amplio en vez de un ajuste
               fino para cubrir variaciones futuras del tamaño del token. -->
          <requestLimits maxQueryString="32768" maxUrl="65536"/>
        </requestFiltering>
      </security>
      <!-- Captura el detalle real (módulo, sc-substatus) del próximo 404 en esta app —
           hoy ese dato se pierde porque el rechazo ocurre antes de llegar al código.
           Requiere que el feature de IIS "Tracing" esté instalado y que "Failed Request
           Tracing" esté activado a nivel de sitio en IIS Manager (no configurable desde
           aquí); sin eso, este bloque no tiene efecto pero tampoco rompe nada. -->
      <tracing>
        <traceFailedRequests>
          <add path="*">
            <traceAreas>
              <add provider="WWW Server" areas="Authentication,Security,Filter,StaticFile,CGI,Compression,Cache,RequestNotifications,Module" verbosity="Verbose"/>
              <add provider="ASPNET" areas="Infrastructure,Module,Page,AppServices" verbosity="Verbose"/>
            </traceAreas>
            <failureDefinitions statusCodes="404"/>
          </add>
        </traceFailedRequests>
      </tracing>
    </system.webServer>
  </location>
</configuration>
